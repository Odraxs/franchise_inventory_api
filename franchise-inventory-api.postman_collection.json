        {
          "name": "1.7 Top-stock report",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "const branches = body.branches || [];",
                  "",
                  "pm.test('one entry per branch', () => {",
                  "  pm.expect(branches).to.have.lengthOf(2);",
                  "});",
                  "",
                  "const downtown = branches.find((branch) => branch.branchName === 'Downtown');",
                  "const uptown = branches.find((branch) => branch.branchName === 'Uptown');",
                  "",
                  "pm.test('Cheeseburger tops Downtown with stock 40', () => {",
                  "  pm.expect(downtown.topProduct.name).to.eql('Cheeseburger');",
                  "  pm.expect(downtown.topProduct.stock).to.eql(40);",
                  "});",
                  "",
                  "pm.test('Uptown has no top product', () => {",
                  "  pm.expect(uptown.topProduct).to.eql(null);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/franchises/:franchiseId/top-stock-products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "franchises",
                ":franchiseId",
                "top-stock-products"
              ],
              "variable": [
                {
                  "key": "franchiseId",
                  "value": "{{franchiseId}}"
                }
              ]
            },
            "description": "Reports the top product of every branch (200). Cheeseburger (40) tops Downtown; Uptown has no products, so `topProduct` is null."
          },
          "response": []
        }
      ]
