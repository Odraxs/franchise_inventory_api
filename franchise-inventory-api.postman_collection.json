    {
      "name": "2. Error contract",
      "description": "The error cases of the README. Every error answers with `{\"code\", \"message\"}`. Run this folder after `1. Smoke test walkthrough`, because some requests reuse the ids created there.",
      "item": [
        {
          "name": "2.1 Duplicate franchise name (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('DUPLICATE_FRANCHISE_NAME', () => {",
                  "  pm.expect(body.code).to.eql('DUPLICATE_FRANCHISE_NAME');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"burger town{{suffix}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/franchises",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "franchises"
              ]
            },
            "description": "Repeats `Burger Town` in another case: names are unique case-insensitively (409 `DUPLICATE_FRANCHISE_NAME`). Needs the franchise from step 1.1."
          },
          "response": []
