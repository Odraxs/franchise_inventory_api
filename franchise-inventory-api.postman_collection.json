  "item": [
    {
      "name": "1. Smoke test walkthrough",
      "description": "The README walkthrough, in order. Each create request saves its new id in a collection variable for the next step.\n\nRun this folder against an empty database, or set `suffix` to a new value first, because the franchise name is unique case-insensitively.",
      "item": [
        {
          "name": "1.1 Create franchise",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns the new franchise id', () => {",
                  "  pm.expect(body.id).to.be.a('string');",
                  "});",
                  "",
                  "pm.collectionVariables.set('franchiseId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Burger Town{{suffix}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/franchises",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "franchises"
              ]
            },
            "description": "Creates the franchise `Burger Town` (201) and stores its id in `franchiseId`."
          },
          "response": []
        },
        {
